<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MonitoreoGMetrixMAUI10.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MonitoreoGMetrixMAUI10"
    Shell.FlyoutBehavior="Disabled"
    xmlns:views="clr-namespace:MonitoreoGMetrixMAUI10.Views"
    Title="MonitoreoGMetrixMAUI">

    <!-- Flyout Estilo UDLA -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#9d1333" Padding="20">
            <Label Text="Monitoreo GMetrix - UDLA"
                   TextColor="White"
                   FontSize="22"
                   HorizontalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Menús -->
    <FlyoutItem Title="Reporte" Icon="ic_report.png">
        <ShellContent ContentTemplate="{DataTemplate views:ReportePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Actualizar Datos" Icon="ic_upload.png">
        <ShellContent ContentTemplate="{DataTemplate views:ActualizarDatosPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Cerrar Sesión" Icon="ic_logout.png">
        <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
    </FlyoutItem>

</Shell>