<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitoreoGMetrixMAUI10.Views.AptosPage"
             Title="Estudiantes Aptos">

    <CollectionView ItemsSource="{Binding Aptos}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="10">
                    <Grid ColumnDefinitions="*,*,*,*">

                        <Label Grid.Column="0" Text="{Binding nombre}" />
                        <Label Grid.Column="1" Text="{Binding apellido}" />
                        <Label Grid.Column="2" Text="{Binding UserName}" />
                        <Label Grid.Column="3" Text="{Binding nrc}" />

                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>