<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitoreoGMetrixMAUI10.Views.DetallesPage"
             xmlns:viewmodel="clr-namespace:MonitoreoGMetrixMAUI10.ViewModels"
             xmlns:converters="clr-namespace:MonitoreoGMetrixMAUI10.Converters"
             x:Name="Page"
             BackgroundColor="#9d1333">

    <ContentPage.BindingContext>
        <viewmodel:DetallesViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="15" Spacing="15">

                <Label Text="Detalle de Estudiantes"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="20"
                       HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding Estudiantes}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="0,5" CornerRadius="10" HasShadow="True"
                                   BackgroundColor="{Binding promedio, Converter={StaticResource ColorPromedioConverter}}">

                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding IsSelected}" 
                                              Color="#ffffff"
                                              VerticalOptions="Center"/>

                                    <Label Grid.Column="1" 
                                           Text="{Binding UserName}" 
                                           VerticalOptions="Center"
                                           TextColor="Black" 
                                           FontAttributes="Bold"/>

                                    <Label Grid.Column="2" 
                                           Text="{Binding promedio, StringFormat='Prom: {0}'}" 
                                           VerticalOptions="Center"
                                           TextColor="Black"/>

                                    <Button Grid.Column="3"
                                            Text="Intentos"
                                            FontSize="12"
                                            HeightRequest="35"
                                            Padding="10,0"
                                            CornerRadius="18"
                                            Command="{Binding BindingContext.VerIntentosCommand, Source={x:Reference Name=Page}}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#9d1333"
                                            TextColor="White"/>
                                </Grid>

                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="15" Padding="20" BackgroundColor="#9d1333">

            <Button Grid.Column="0"
                    Text="Enviar Notificación" 
                    Command="{Binding EnviarNotificacionesCommand}"
                    BackgroundColor="White" 
                    TextColor="#9d1333" 
                    BorderColor="White" 
                    BorderWidth="1"
                    FontAttributes="Bold"
                    CornerRadius="20"/>

            <Button Grid.Column="1"
                    Text="🤖 Notificaciones de Riesgo"
                    Command="{Binding VerPrediccionesCommand}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="20"
                    Shadow="{Shadow Brush=Black, Offset='2,2', Opacity=0.3}">

                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00C6FF" Offset="0.0" />
                        <GradientStop Color="#9D50BB" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>

            </Button>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="2"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsBusy}"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="White"
                                   HeightRequest="50" WidthRequest="50"/>
                <Label Text="Cargando detalles..." 
                       TextColor="White"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>