<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitoreoGMetrixMAUI10.Views.PrediccionesPage"
             xmlns:viewmodel="clr-namespace:MonitoreoGMetrixMAUI10.ViewModels"
             Title="Asistente Predictivo IA"
             BackgroundColor="#9d1333">
    <ContentPage.BindingContext>
        <viewmodel:PrediccionesViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label Text="🤖 Análisis de Riesgo" 
                       FontSize="22" FontAttributes="Bold" 
                       TextColor="#ffffff" HorizontalOptions="Center"/>

                <CollectionView ItemsSource="{Binding Predicciones}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,5" Padding="15" CornerRadius="10" HasShadow="True" BorderColor="Transparent">
                                <VerticalStackLayout Spacing="5">

                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="{Binding Estudiante}" 
                                               FontAttributes="Bold" FontSize="16" TextColor="#ffffff"/>

                                        <Frame Grid.Column="1" Padding="8,4" CornerRadius="5" 
                                               BackgroundColor="{Binding ColorRiesgo}" HasShadow="False">
                                            <Label Text="{Binding NivelRiesgo}" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                                        </Frame>
                                    </Grid>

                                    <Label Text="{Binding ProbabilidadReprobacion, StringFormat='Probabilidad de Reprobación: {0}%'}"
                                           TextColor="#ffffff" FontSize="13"/>

                                    <BoxView HeightRequest="1" Color="#EEE" Margin="0,5"/>

                                    <Label Text="{Binding MensajeIA}" 
                                           TextColor="#ffffff" FontSize="14" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Margin="0,50,0,0">
                            <Label Text="✅" FontSize="50" HorizontalOptions="Center"/>
                            <Label Text="No se detectan riesgos académicos." TextColor="Gray" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" 
                           Color="{StaticResource Primary}" VerticalOptions="Center" HorizontalOptions="Center"/>
    </Grid>
</ContentPage>