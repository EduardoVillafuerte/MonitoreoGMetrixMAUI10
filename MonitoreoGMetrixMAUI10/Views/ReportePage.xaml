<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonitoreoGMetrixMAUI10.Views.ReportePage"
             x:Name="Page"
             BackgroundColor="#9d1333"
             Title="Reporte GMetrix">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label Text="Reporte GMetrix" 
                       Style="{StaticResource TituloUDLA}"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       Margin="0,0,0,10"/>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="15,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                    <Picker Title="Facultad"
                            TextColor="Black" TitleColor="Gray"
                            ItemsSource="{Binding Facultades}"
                            ItemDisplayBinding="{Binding Nombre}"
                            SelectedItem="{Binding FacultadSeleccionada}"
                            VerticalOptions="Center"/>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="15,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                    <Picker Title="Carrera"
                            TextColor="Black" TitleColor="Gray"
                            ItemsSource="{Binding Carreras}"
                            ItemDisplayBinding="{Binding Nombre}"
                            SelectedItem="{Binding CarreraSeleccionada}"
                            VerticalOptions="Center"/>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="15,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                    <Picker Title="Periodo"
                            TextColor="Black" TitleColor="Gray"
                            ItemsSource="{Binding Periodos}"
                            ItemDisplayBinding="{Binding Codigo}"
                            SelectedItem="{Binding PeriodoSeleccionado}"
                            VerticalOptions="Center"/>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="15,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                    <Picker Title="Certificación"
                            TextColor="Black" TitleColor="Gray"
                            ItemsSource="{Binding Certificaciones}"
                            ItemDisplayBinding="{Binding Nombre}"
                            SelectedItem="{Binding CertificacionSeleccionada}"
                            VerticalOptions="Center"/>
                </Border>

                <Button Text="Filtrar"
                        Command="{Binding FiltrarCommand}"
                        BackgroundColor="#111111"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        FontAttributes="Bold"/>

                <CollectionView ItemsSource="{Binding ReportesAgrupados}" Margin="0,10,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="8" Margin="0,0,0,15">
                                
                                <Label Text="{Binding NombreCertificacion}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       Margin="5,0"/>

                                <CollectionView ItemsSource="{Binding Materias}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame Padding="10" Margin="0,5" CornerRadius="10" HasShadow="True"
                                                   BackgroundColor="{Binding promedio, Converter={StaticResource ColorPromedioConverter}}">

                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                                    
                                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                                        <Label Text="{Binding nombreMateria}" FontAttributes="Bold" TextColor="Black" LineBreakMode="TailTruncation"/>
                                                        <Label Text="{Binding materiaCodigo}" FontSize="12" TextColor="#333"/>
                                                    </VerticalStackLayout>

                                                    <Label Grid.Column="1" Text="{Binding NRC}" VerticalOptions="Center" TextColor="Black"/>

                                                    <Button Grid.Column="3"
                                                            Text="Detalles"
                                                            FontSize="12"
                                                            HeightRequest="35"
                                                            Padding="10,0"
                                                            CornerRadius="18"
                                                            Command="{Binding BindingContext.VerDetallesCommand, Source={x:Reference Name=Page}}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="#9d1333"
                                                            TextColor="White" />
                                                </Grid>

                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <Grid BackgroundColor="#80000000"
              IsVisible="{Binding IsBusy}"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="White"
                                   HeightRequest="50" WidthRequest="50"/>
                <Label Text="Procesando..." 
                       TextColor="White" 
                       FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>